---
import { ClientRouter } from 'astro:transitions'

import { config } from '@/config'
import { getSettingsView } from '@/lib/content'

import '@/globals.css'

import '@fontsource-variable/onest'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
  noindex?: boolean
}

const SITE = config.site.url
const settings = await getSettingsView()

const {
  title,
  description = settings.defaultSeo?.metaDescription,
  canonical = '/',
  ogImage = settings.defaultSeo?.ogImage,
  noindex = false,
} = Astro.props

const fullTitle = title
  ? `${title} | ${settings.companyName}`
  : settings.defaultSeo?.metaTitle || settings.companyName
const canonicalURL = new URL(canonical, SITE)
const ogImageURL = ogImage ? new URL(ogImage, SITE) : null
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Add your favicon files to /public/icons and wire them here. */}
    <link rel="manifest" href="/manifest.webmanifest" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={settings.companyName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <ClientRouter />
  </head>
  <body class="min-h-screen w-full bg-background overflow-x-hidden">
    <main>
      <slot />
    </main>

    <script>
      import { destroySmoothScroll, initSmoothScroll } from '@/lib/smooth-scroll'

      let isPopStateNavigation = false
      let pendingScrollReset = false
      let isPointerNavigation = false

      const HEADER_OFFSET = 100

      document.addEventListener(
        'pointerdown',
        (e) => {
          const target = e.target
          isPointerNavigation = target instanceof Element && !!target.closest('a[href]')
        },
        { capture: true }
      )

      document.addEventListener(
        'keydown',
        () => {
          isPointerNavigation = false
        },
        { capture: true }
      )

      function scrollToHashOrTop() {
        const hash = window.location.hash
        if (hash) {
          const el = document.getElementById(decodeURIComponent(hash.slice(1)))
          if (el) {
            const y = el.getBoundingClientRect().top + window.scrollY - HEADER_OFFSET
            window.scrollTo(0, y)
            if (window.appLenis) window.appLenis.scrollTo(y, { immediate: true, force: true })
            return
          }
        }
        window.scrollTo(0, 0)
        document.documentElement.scrollTop = 0
        document.body.scrollTop = 0
        if (window.appLenis) window.appLenis.scrollTo(0, { immediate: true, force: true })
      }

      function restoreSavedScroll() {
        const saved = (history.state as { scrollY?: number } | null)?.scrollY
        const y = typeof saved === 'number' ? saved : window.scrollY
        const apply = () => {
          window.scrollTo(0, y)
          if (window.appLenis) window.appLenis.scrollTo(y, { immediate: true, force: true })
        }
        apply()
        requestAnimationFrame(() => {
          if (Math.abs(window.scrollY - y) > 1) apply()
        })
      }

      function initLayout() {
        initSmoothScroll()
        if (pendingScrollReset) {
          pendingScrollReset = false
          scrollToHashOrTop()
        } else {
          restoreSavedScroll()
        }
      }

      initLayout()
      document.addEventListener('astro:page-load', () => initLayout())

      document.addEventListener('astro:before-preparation', (e) => {
        const ev = e as Event & {
          navigationType?: 'push' | 'replace' | 'traverse'
          direction?: 'forward' | 'back'
        }
        if (
          ev.navigationType === 'traverse' ||
          ev.direction === 'back' ||
          ev.direction === 'forward'
        ) {
          isPopStateNavigation = true
        } else {
          isPopStateNavigation = false
        }
      })

      document.addEventListener(
        'click',
        (e) => {
          const target = e.target
          if (target instanceof HTMLElement) {
            const anchor = target.closest('a')
            if (!anchor) return
            const href = anchor.getAttribute('href')
            if (!href) return

            try {
              const destUrl = new URL(href, window.location.href)
              const normalize = (p: string) => p.replace(/\/$/, '') || '/'

              if (
                destUrl.origin === window.location.origin &&
                normalize(destUrl.pathname) === normalize(window.location.pathname) &&
                destUrl.search === window.location.search
              ) {
                e.preventDefault()
                e.stopPropagation()
                if (destUrl.hash) {
                  const id = decodeURIComponent(destUrl.hash.slice(1))
                  const el = document.getElementById(id)
                  if (el) {
                    const headerOffset = 100
                    const y = el.getBoundingClientRect().top + window.scrollY - headerOffset
                    if (window.appLenis) {
                      window.appLenis.scrollTo(y)
                    } else {
                      window.scrollTo({ top: y, behavior: 'smooth' })
                    }
                    history.replaceState(null, '', destUrl.hash)
                  }
                } else {
                  if (window.appLenis) {
                    window.appLenis.scrollTo(0)
                  } else {
                    window.scrollTo({ top: 0, behavior: 'smooth' })
                  }
                }
              }
            } catch (err) {}
          }
        },
        { capture: true }
      )

      function blurPersistedLink() {
        if (!isPointerNavigation) return
        const active = document.activeElement
        if (
          active instanceof HTMLElement &&
          active.matches('a[href]') &&
          active.closest('[data-astro-transition-persist]')
        ) {
          active.blur()
        }
      }

      document.addEventListener('astro:before-swap', () => {
        destroySmoothScroll()
        blurPersistedLink()
        if (!isPopStateNavigation) {
          window.scrollTo(0, 0)
          document.documentElement.scrollTop = 0
          document.body.scrollTop = 0
        }
        document.dispatchEvent(new CustomEvent('app:navigate'))
      })

      document.addEventListener('astro:after-swap', () => {
        if (!isPopStateNavigation) {
          window.scrollTo(0, 0)
          document.documentElement.scrollTop = 0
          document.body.scrollTop = 0
          pendingScrollReset = true
        }
        isPopStateNavigation = false
      })
    </script>
  </body>
</html>
